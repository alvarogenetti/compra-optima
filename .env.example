# Proveedor de IA: "gemini" (gratis con límites) o "demo" (sin IA: preguntas fijas, sirve para probar la interfaz)
AI_PROVIDER=gemini

# Clave gratis de Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Modelos de Gemini, en orden de preferencia: si uno está saturado o sin cupo gratis, se usa el siguiente.
GEMINI_MODEL=gemini-3-flash-preview,gemini-flash-lite-latest,gemini-flash-latest

# Opcional: los comentarios de "¿Te sirvió?" te llegan por Telegram (sirve el mismo bot del tracker)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Sólo en la versión publicada: código que pide la web antes de usar la IA (vacío = no pide)
ACCESS_CODE=

# Seguir precio (Fase 2): bot NUEVO de Compra Óptima (no el del tracker) y base Postgres de Neon.
# Sin DATABASE_URL, en tu PC usa SQLite en data/compra.db.
COMPRA_BOT_TOKEN=
DATABASE_URL=
