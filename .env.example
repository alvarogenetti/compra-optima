# IA: alcanza con una clave (abajo). AI_PROVIDER=demo fuerza el modo sin IA (preguntas fijas, para probar la interfaz).
# AI_PROVIDER=demo

# Clave gratis de Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Modelos de Gemini en orden: primero los Flash Lite (plan gratis: 15 por minuto y 500 por día cada uno); los Flash (5 por minuto y 20 por día) quedan de respaldo.
GEMINI_MODEL=gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemini-flash-lite-latest,gemini-3-flash-preview,gemini-3.5-flash,gemini-flash-latest

# Opcional: los comentarios de "¿Te sirvió?" te llegan por Telegram (sirve el mismo bot del tracker)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Sólo en la versión publicada: código que pide la web antes de usar la IA (vacío = no pide)
ACCESS_CODE=

# Seguir precio (Fase 2): bot NUEVO de Compra Óptima (no el del tracker) y base Postgres de Neon.
# Sin DATABASE_URL, en tu PC usa SQLite en data/compra.db.
COMPRA_BOT_TOKEN=
DATABASE_URL=

# Otras IA gratis, en cadena: si una se queda sin cupo o falla, se usa la siguiente (orden: AI_CHAIN).
# Groq: https://console.groq.com/keys · OpenRouter: https://openrouter.ai/keys
# Cerebras ya no tiene plan gratis (desde julio de 2026: prueba de $5 y después pago por uso): está soportada pero fuera de la cadena por defecto
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
# AI_CHAIN=gemini,groq,openrouter
# Orden de IA por tarea (ver docs/AI.md): preguntas -> groq primero; perfil y evaluación -> gemini primero.
# AI_ROUTE_INTERVIEW=groq,gemini,openrouter
# AI_ROUTE_PROFILE=gemini,groq,openrouter
# AI_ROUTE_EVALUATE=gemini,groq,openrouter
